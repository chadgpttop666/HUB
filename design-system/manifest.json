  "components": [
    {
      "name": "AppShell",
      "group": "Экраны",
      "summary": "Как выглядит любое приложение, открытое внутри хаба: слева панель приложений, сверху строка ввода и статус, остальное — область приложения."
    },
    {
      "name": "Backdrop",
      "group": "Основа",
      "summary": "Фото темы на весь экран, вуаль и полупрозрачное стекло — основа всех экранов; рисует их только сам хаб."
    },
    {
      "name": "BarChart",
      "group": "Данные",
      "summary": "Одна величина по дням или неделям для статистики приложений; одна серия, без легенды — заголовок называет, что посчитано."
    },
    {
      "name": "BottomNav",
      "group": "Оболочка хаба",
      "summary": "Разделы хаба на телефоне: «Сегодня», «Корзина», «Приложения», «Настройки»."
    },
    {
      "name": "Button",
      "group": "Действия",
      "summary": "Действие одним нажатием; по умолчанию — обычная (контур), основная — не больше одной на экран."
    },
    {
      "name": "CaptureBar",
      "group": "Оболочка хаба",
      "summary": "Главный элемент хаба: мысль падает в корзину за пару секунд — набрал, Enter, дальше."
    },
    {
      "name": "CaptureScreen",
      "group": "Экраны",
      "summary": "Строка ввода в работе: на «Сегодня» и в мини-окне поверх других программ. Устройство самой строки — компонент «Строка быстрого ввода»."
    },
    {
      "name": "Card",
      "group": "Контейнеры",
      "summary": "Карточку на «Сегодня» даёт приложение; форма у всех одна и та же, наполнение — четыре поля."
    },
    {
      "name": "Checkbox",
      "group": "Ввод",
      "summary": "Отметка «сделано / выбрано»; вся строка с текстом — одна цель для нажатия."
    },
    {
      "name": "CommandScreen",
      "group": "Экраны · вторая очередь",
      "summary": "Ctrl K из любого места: найти приложение, выполнить команду или открыть запись — не трогая мышь."
    },
    {
      "name": "Dialog",
      "group": "Окна и сообщения",
      "summary": "Окно поверх экрана для одного решения: подтвердить необратимое или ввести одно-два значения."
    },
    {
      "name": "DirectionA",
      "group": "Направления",
      "summary": "Доработанный прототип: всё по центру, строка ввода первой, карточки приложений сеткой под ней. Выбрано (пока): на нём собраны все экраны ПК; телефон повторяет…"
    },
    {
      "name": "DirectionB",
      "group": "Направления",
      "summary": "Всё в одной колонке слева, как страница личного дневника: дата, приветствие, строка ввода, список дел по приложениям строками, без карточек. Правая половина от…"
    },
    {
      "name": "DirectionC",
      "group": "Направления",
      "summary": "Строка ввода стоит посередине экрана, как линия горизонта на фото; часы и дата — маленьким блоком слева сверху; карточки — одна полка у нижнего края."
    },
    {
      "name": "EmptyState",
      "group": "Состояния",
      "summary": "Что показать, когда показывать нечего: всё сделано, ничего не найдено, приложение ещё без данных."
    },
    {
      "name": "ExampleApp",
      "group": "Экраны",
      "summary": "Проверка набора: экран приложения повторения собран только из классов hub.css, типографских стилей t-* и токенов — ни одного своего цвета или шрифта."
    },
    {
      "name": "Icons",
      "group": "Основа",
      "summary": "Один линейный набор — Lucide (лицензия ISC): у каждой иконки сетка 24, линия 1.6, скругленные концы, цвет — currentColor."
    },
    {
      "name": "InstallScreen",
      "group": "Экраны · вторая очередь",
      "summary": "Перетащил папку или zip в хаб → посмотрел, что приложение просит → «Установить»."
    },
    {
      "name": "ListRow",
      "group": "Контейнеры",
      "summary": "Одна запись в списке: слева значок или чекбокс, в середине название и пояснение, справа число, тег, клавиша или стрелка."
    },
    {
      "name": "LiveFlow",
      "group": "Экраны",
      "summary": "Рабочий прототип, пересобранный на hub.css: заставка → пароль → «Сегодня» → мысль в корзину. Кликните по экрану, затем любая клавиша; пароль — «лес»."
    },
    {
      "name": "Loading",
      "group": "Состояния",
      "summary": "Как показать ожидание: кружок — для действия, скелет — для содержимого, полоса — для долгого процесса."
    },
    {
      "name": "LockScreen",
      "group": "Экраны",
      "summary": "Первое, что видно при включении компьютера: фото темы, время, дата и приветствие; любая клавиша проявляет поле пароля."
    },
    {
      "name": "Menu",
      "group": "Окна и сообщения",
      "summary": "Список действий или вариантов, который открывается от кнопки или поля и закрывается после выбора."
    },
    {
      "name": "PhoneCapture",
      "group": "Телефон",
      "summary": "На телефоне мысль попадает в корзину тремя путями: строка на «Сегодня», виджет на рабочем столе и «Поделиться» из любой программы."
    },
    {
      "name": "PhoneLock",
      "group": "Телефон",
      "summary": "Тот же вход, что на ПК, под палец: заставка → касание → пароль с открытой клавиатурой."
    },
    {
      "name": "PhoneToday",
      "group": "Телефон",
      "summary": "«Сегодня» на телефоне — те же строка ввода и карточки, только столбиком и с нижней панелью разделов."
    },
    {
      "name": "PhoneTriage",
      "group": "Телефон",
      "summary": "Разбор под большой палец: один элемент карточкой, решение — жестом."
    },
    {
      "name": "PhoneWidget",
      "group": "Телефон",
      "summary": "Самый короткий путь мысли в корзину на телефоне: касание виджета → текст → «Отправить»."
    },
    {
      "name": "Progress",
      "group": "Данные",
      "summary": "Сколько сделано из известного целого: полоса для непрерывного, шаги — для счётных частей вроде учебных блоков."
    },
    {
      "name": "Select",
      "group": "Ввод",
      "summary": "Выбор одного варианта из известного списка: тема, папка, режим синхронизации."
    },
    {
      "name": "SetupScreen",
      "group": "Экраны · вторая очередь",
      "summary": "Один раз, при первом запуске: четыре шага на плотном стекле поверх размытого фото, по одному решению на экран."
    },
    {
      "name": "Sheet",
      "group": "Окна и сообщения",
      "summary": "Выбор или короткий ввод на телефоне, не уводящий с экрана: куда перенести, когда напомнить, «Поделиться» в корзину."
    },
    {
      "name": "Stepper",
      "group": "Окна и сообщения",
      "summary": "Где человек в коротком пошаговом процессе: первая настройка, подключение телефона."
    },
    {
      "name": "Switch",
      "group": "Ввод",
      "summary": "Включает или выключает настройку сразу, без кнопки «Сохранить»."
    },
    {
      "name": "SyncScreen",
      "group": "Экраны · вторая очередь",
      "summary": "Где видно и решается всё про Google Drive: папки, конфликты, первая синхронизация и защита от массового удаления."
    },
    {
      "name": "SyncStatus",
      "group": "Оболочка хаба",
      "summary": "Одна строка в шапке, по которой видно, всё ли уехало на Drive; громким становится только конфликт."
    },
    {
      "name": "Table",
      "group": "Данные",
      "summary": "Данные, которые сравнивают по столбцам: темы повторения, история блоков, список файлов синхронизации."
    },
    {
      "name": "Tabs",
      "group": "Контейнеры",
      "summary": "Вкладки делят экран приложения на разделы; сегменты переключают вид одного и того же (период, сортировку)."
    },
    {
      "name": "Tag",
      "group": "Ввод",
      "summary": "Короткая метка у записи (#учёба, «с телефона») или переключаемый фильтр."
    },
    {
      "name": "TextField",
      "group": "Ввод",
      "summary": "Всё, куда пишут: строка hub-input, многострочное hub-textarea, поиск hub-search, число hub-number и поле-линия hub-input--line для экрана входа."
    },
    {
      "name": "Themes",
      "group": "Основа",
      "summary": "Тема — это фото плюс набор значений токенов; разметка и hub.css одни на все темы."
    },
    {
      "name": "ThemesScreen",
      "group": "Экраны · вторая очередь",
      "summary": "Галерея тем и настройка одной темы; новая тема собирается из любого фото по правилу из раздела «Темы»."
    },
    {
      "name": "Timer",
      "group": "Данные",
      "summary": "Обратный отсчёт с кольцом: учебные блоки, ограничение времени на карточку."
    },
    {
      "name": "Toast",
      "group": "Окна и сообщения",
      "summary": "Короткое сообщение внизу по центру о том, что уже произошло; само исчезает через 4 секунды."
    },
    {
      "name": "TodayScreen",
      "group": "Экраны",
      "summary": "Главный экран после входа: строка «Мысль в корзину…» с курсором и под ней — карточки приложений; через него проходят за секунды, а не живут в нём."
    },
    {
      "name": "TriageScreen",
      "group": "Экраны",
      "summary": "Один элемент крупно и под ним — приложения, которые могут его принять; разбирают с клавиатуры, по элементу за пару секунд."
    }
  ],
