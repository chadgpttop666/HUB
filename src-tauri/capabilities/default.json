{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Окно хаба: события ядра и выбор папки. Команды хаба разрешены по умолчанию.",
  "windows": [
    "main",
    "mini"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://console.cloud.google.com/**" }] },
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-internal-toggle-maximize"
  ]
}
