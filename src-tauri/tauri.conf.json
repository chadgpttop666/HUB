{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Хаб",
  "version": "0.1.6",
  "mainBinaryName": "hub",
  "identifier": "local.hub.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node scripts/build-ui.mjs",
    "beforeBuildCommand": "node scripts/build-ui.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Хаб",
        "url": "index.html",
        "width": 1320,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "visible": true,
        "focus": true,
        "backgroundColor": "#0d1511",
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "Личный хаб",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian"
        ]
      }
    },
    "externalBin": [
      "binaries/rclone"
    ]
  }
}
